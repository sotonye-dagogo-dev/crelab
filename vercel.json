{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install --legacy-peer-deps",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "preview": true
    }
  },
  "functions": {
    "app/api/media/upload/route.ts": { "maxDuration": 300 },
    "app/api/media/batch-upload/route.ts": { "maxDuration": 300 },
    "app/api/media/confirm/route.ts": { "maxDuration": 60 },
    "app/api/media/assets/[id]/replace/route.ts": { "maxDuration": 300 }
  },
  "crons": [
    {
      "path": "/api/cron/drive-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/escrow",
      "schedule": "1 0 * * *"
    },
    {
      "path": "/api/cron/milestones",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/media-cleanup",
      "schedule": "10 0 * * *"
    }
  ]
}
