# Database
DATABASE_URL=postgres://user:pass@host:5432/crelab

# Better Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=ba_your-api-key-here

# Public origin used to build absolute links in emails (logo URL, verify links,
# booking links, og:image/canonical in SEO meta tags). Falls back to VERCEL_URL
# when unset in production, and to http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (for RLS)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Google OAuth (Better Auth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary (media upload pipeline + asset management)
# Required for the full pipeline. Cloud name + upload preset enable direct
# uploads; the API key + secret additionally enable deletion and the orphan
# cleanup job (asset management / failed-upload cleanup).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
# Legacy variables — still honoured as fallbacks for uploads (optional):
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Resend (transactional email — welcome, booking confirmation, payment received)
RESEND_API_KEY=re_your-resend-api-key
# Sender identity (optional — defaults to the admin-editable config, which is
# "Crellab <hello@mail.crellab.com>"). Resend recommends NOT using a "no-reply"
# address (decreases trust — recipients can't reply/report spam) and sending
# from a SUBDOMAIN (e.g. mail.yourdomain.com) rather than the root domain, so
# sending is segmented by purpose and root-domain reputation is protected.
# The subdomain + address must be verified in your Resend dashboard first.
RESEND_FROM_NAME=Crellab
RESEND_FROM_EMAIL=hello@mail.crellab.com

# Cron endpoints (authorization header for /api/cron/* — keep secret)
# Generate this yourself (never commit a real value):
#   openssl rand -hex 32
# A 64-char hex string is recommended (>= 32 chars). Set it in BOTH places:
# (1) your platform env vars (Vercel project settings), and (2) the cron
# scheduler you use (Vercel Cron, GitHub Actions, cron-job.org, BetterStack,
# etc.) so that scheduler sends the matching `Authorization: Bearer <secret>`
# header when it calls the endpoint.
CRON_SECRET=your-cron-secret

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Google Drive / APIs
GOOGLE_API_KEY=your-google-api-key
# Drive API hardening knobs (all optional — defaults shown; sit well under
# Google's limits: 20k queries/min per project, 1.2k per user/IP):
# Max files pulled per folder ingest (Drive folders can hold 500k items —
# the cap bounds a single sync; result is flagged "truncated" when hit).
DRIVE_MAX_FILES_PER_FOLDER=500
# Retry budget + exponential-backoff base for 429 / rate-limit-403 responses
# (Retry-After header is honoured when Google sends it).
DRIVE_FETCH_MAX_RETRIES=3
DRIVE_FETCH_RETRY_BASE_MS=750
# Per-process request pacing (min spacing + sliding 60s window cap; note:
# serverless isolates each get their own budget — defaults stay conservative).
DRIVE_MIN_REQUEST_INTERVAL_MS=200
DRIVE_MAX_REQUESTS_PER_MINUTE=600

# Public app URL (used for sitemap/robots)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mock data mode — set to "true" to enable mock data when DB is unavailable
NEXT_PUBLIC_MOCK_DATA=true
